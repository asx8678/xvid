{
  "manifest_version": 3,
  "name": "xHelper",
  "version": "4.0.5",
  "description": "Adds a download button to X.com videos that always saves the highest-quality MP4.",
  "homepage_url": "https://github.com/asx8678/xvid",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["downloads"],
  "host_permissions": ["https://cdn.syndication.twimg.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
